# SkyWalking Agent 配置
# 下载: https://skywalking.apache.org/downloads/
# 解压后设置 SW_HOME 环境变量

# OAP Server 地址
SW_AGENT_NAME=rx-admin
SW_AGENT_COLLECTOR_BACKEND_SERVICES=localhost:11800

# 采样率（1.0 = 100%）
SW_AGENT_SAMPLE=1.0

# 日志目录
SW_AGENT_LOG_DIR=logs/skywalking

# 忽略路径（静态资源、健康检查等）
SW_AGENT_IGNORE_PATH=/api/v1/auth/captcha,/actuator/**,/api/v1/notification/stream,/api/v1/ws/**
