# RX Admin — 开发环境变量
# 仅包含 VITE_ 前缀的变量会被注入到客户端代码（import.meta.env.VITE_xxx）

# ── 轮询/心跳 ──
# 会话心跳间隔（毫秒）
VITE_HEARTBEAT_INTERVAL=10000
# 心跳请求超时（毫秒）
VITE_HEARTBEAT_TIMEOUT=5000
# 通知轮询间隔（毫秒）
VITE_NOTICE_POLL_INTERVAL=60000
# 抓取进度轮询间隔（毫秒）
VITE_FETCH_PROGRESS_POLL_INTERVAL=10000
# 被踢下线倒计时（秒）
VITE_KICKOUT_COUNTDOWN=5

# ── 表格配置 ──
# 表格行高（px），用于高度自适应计算
VITE_TABLE_ROW_HEIGHT=48
# 表格底部预留空间（px），useTablePage 计算高度时从窗口高度中扣除
VITE_TABLE_PADDING=120
# 默认每页条数
VITE_DEFAULT_PAGE_SIZE=10
# 可选每页条数（逗号分隔）
VITE_PAGE_SIZE_OPTIONS=10,20,50,100
# 默认表格最大高度（px）
VITE_TABLE_MAX_HEIGHT=400
# 经典文学页面表格行高（px）
VITE_CLASSICS_TABLE_ROW_HEIGHT=44
# 经典文学页面表头高度（px）
VITE_CLASSICS_TABLE_HEADER_HEIGHT=40
# 经典文学页面默认最大可见行数
VITE_CLASSICS_TABLE_MAX_ROWS=16

# ── 请求超时 ──
# 通用 API 请求超时（毫秒）
VITE_API_REQUEST_TIMEOUT=15000
# AS400 远程连接请求超时（毫秒）
VITE_AS400_REQUEST_TIMEOUT=60000

# ── 业务延迟 ──
# 音乐播放器搜索防抖延迟（毫秒）
VITE_MUSIC_SEARCH_DEBOUNCE_MS=300
# 流程图初始化 DOM 就绪轮询间隔（毫秒）
VITE_FLOWCHART_INIT_RETRY_MS=50
